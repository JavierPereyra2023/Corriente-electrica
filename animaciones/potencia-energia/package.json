{
  "name": "potencia-energia-circuito",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.jsx --no-open",
    "studio:lentes": "remotion studio src/index.jsx --no-open --public-dir=../../assets",
    "render:lentes-laser": "remotion render src/index.jsx LentesLaserRealista ../../assets/lentes/lentes-laser.mp4 --public-dir=../../assets --codec=h264 --crf=20 --pixel-format=yuv420p --concurrency=3 --muted",
    "still:lentes-laser": "remotion still src/index.jsx LentesLaserRealista ../../assets/lentes/lentes-laser-poster.png --public-dir=../../assets --frame=420",
    "check:lentes-laser": "node scripts/check-lentes-laser.mjs",
    "build:web": "node scripts/build-web.mjs",
    "render": "remotion render src/index.jsx InfografiaPotenciaEnergia ../../assets/potencia-energia/infografia-potencia-energia.mp4 --codec=h264 --crf=19 --concurrency=4",
    "still": "remotion still src/index.jsx InfografiaPotenciaEnergia ../../assets/potencia-energia/infografia-potencia-energia.png --frame=300",
    "render:ondas": "remotion render src/index.jsx OndasMecanicas ../../assets/ondas/ondas-mecanicas.mp4 --codec=h264 --crf=19 --concurrency=4",
    "still:ondas": "remotion still src/index.jsx OndasMecanicas ../../assets/ondas/ondas-mecanicas.png --frame=330",
    "render:luz-cuantica": "remotion render src/index.jsx ModelosLuzCuantica ../../assets/luz-cuantica/modelos-luz-maxwell-foton.mp4 --codec=h264 --crf=19 --concurrency=4",
    "still:luz-cuantica": "remotion still src/index.jsx ModelosLuzCuantica ../../assets/luz-cuantica/modelos-luz-maxwell-foton.png --frame=615",
    "render:bohr": "remotion render src/index.jsx SaltosCuanticosBohr ../../assets/bohr/saltos-cuanticos.mp4 --codec=h264 --crf=19 --concurrency=4 --muted",
    "still:bohr": "remotion still src/index.jsx SaltosCuanticosBohr ../../assets/bohr/saltos-cuanticos.png --frame=425",
    "render:compton": "remotion render src/index.jsx ComptonDispersion ../../assets/compton/compton-dispersion.mp4 --codec=h264 --crf=19 --concurrency=4 --muted",
    "still:compton": "remotion still src/index.jsx ComptonDispersion ../../assets/compton/compton-dispersion.png --frame=420"
  },
  "dependencies": {
    "@remotion/cli": "4.0.513",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.513"
  }
}
